[
  {
    "name": "Create Category - Valid",
    "method": "POST",
    "path": "/api/categories",
    "body": {
      "name": "Programming",
      "description": "Tech books"
    },
    "expect": 201
  },
  {
    "name": "Create Category - Another",
    "method": "POST",
    "path": "/api/categories",
    "body": {
      "name": "Fiction",
      "description": "Novel books"
    },
    "expect": 201
  },
  {
    "name": "Create Category - Invalid (Empty Name)",
    "method": "POST",
    "path": "/api/categories",
    "body": {
      "name": "",
      "description": "Invalid"
    },
    "expect": 400
  },
  {
    "name": "Create Category - Duplicate",
    "method": "POST",
    "path": "/api/categories",
    "body": {
      "name": "Programming",
      "description": "Duplicate test"
    },
    "expect": 400
  },

  {
    "name": "Get All Categories",
    "method": "GET",
    "path": "/api/categories",
    "expect": 200
  },
  {
    "name": "Get Category By Id - Valid",
    "method": "GET",
    "path": "/api/categories/1",
    "expect": 200
  },
  {
    "name": "Get Category By Id - Not Found",
    "method": "GET",
    "path": "/api/categories/999",
    "expect": 404
  },

  {
    "name": "Update Category - Valid",
    "method": "PUT",
    "path": "/api/categories/1",
    "body": {
      "name": "Programming Updated",
      "description": "Updated desc"
    },
    "expect": 200
  },
  {
    "name": "Update Category - Duplicate Name",
    "method": "PUT",
    "path": "/api/categories/1",
    "body": {
      "name": "Fiction",
      "description": "Conflict"
    },
    "expect": 400
  },
  {
    "name": "Update Category - Invalid (Empty Name)",
    "method": "PUT",
    "path": "/api/categories/1",
    "body": {
      "name": "",
      "description": "Invalid"
    },
    "expect": 400
  },
  {
    "name": "Update Category - Not Found",
    "method": "PUT",
    "path": "/api/categories/999",
    "body": {
      "name": "Not Found",
      "description": ""
    },
    "expect": 404
  },

  {
    "name": "Delete Category - Valid",
    "method": "DELETE",
    "path": "/api/categories/2",
    "expect": 204
  },
  {
    "name": "Delete Category - Not Found",
    "method": "DELETE",
    "path": "/api/categories/999",
    "expect": 404
  },

  {
    "name": "Delete Category - Has Book (Business Rule)",
    "method": "DELETE",
    "path": "/api/categories/1",
    "expect": 400
  }
